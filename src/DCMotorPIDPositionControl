#include <Wire.h>
#include <LiquidCrystal_I2C.h>

// Motor driver pins - L298N
const int ENA = 10; // Allows for PWM
const int IN1 = 8;
const int IN2 = 9;

// Encoder pins
const int ENCODER_A = 3;
const int ENCODER_B = 4;


//LCD
LiquidCrystal_I2C lcd(0x27, 16, 2);
unsigned long previousMillisLCD = 0;
const unsigned long intervalLCD = 100;

//rotary pins
const int rotaryCLK = 7;
const int rotaryDT = 6;
const int rotarySW = 5;
int previousCLK = digitalRead(rotaryCLK);

// position counter
volatile long encoderPos = 0;

// PID tuning
float Kp = 0.3; // proportional gain

float Ki = 0.05; // intergral gain

float Kd = 0.02; // derivitve gain

// controll variables
long targetPos = 0;

const int MIN_PWM = 60;

double previousError = 0;
double cumulativeError = 0;
unsigned long previousMillis = 0;


// encoder interrupt
void readEncoder(){
  if (digitalRead(ENCODER_B)==LOW){
    encoderPos++;
  }else{
    encoderPos--;
  }
}

// motor control functions

void stopMotor(){
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  analogWrite(ENA,0);
}
void spinForward(int speed){
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  analogWrite(ENA,speed);
}

void spinBackward(int speed){
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  analogWrite(ENA,speed);
}

void setup() {
  Serial.begin(9600);

  // motor driver
  pinMode(ENA, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);

  //encoder
  pinMode(ENCODER_A, INPUT_PULLUP);
  pinMode(ENCODER_B, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(ENCODER_A), readEncoder, RISING);

  //lcd
  lcd.init();
  lcd.backlight();
  lcd.clear();

  //rotary
  pinMode(rotaryCLK, INPUT_PULLUP);
  pinMode(rotaryDT, INPUT_PULLUP);
  previousCLK = digitalRead(rotaryCLK);
}

void  updateLCD(){
  lcd.clear();

  lcd.setCursor(0,0);
  lcd.print("Target: ");
  lcd.print(targetPos);


  lcd.setCursor(0,1);
  lcd.print("Current: ");
  lcd.print(encoderPos);
}

void updateRotary(){
  int currentCLK = digitalRead(rotaryCLK);
  if (currentCLK != previousCLK && currentCLK == LOW){
    if (digitalRead(rotaryDT) != currentCLK){
      targetPos += 25;
    }else{
      targetPos -= 25;
    }
  }
  previousCLK = currentCLK;
}

void loop(){
    updateRotary();
    unsigned long currentMillis = millis();
    double dt = (double)(currentMillis-previousMillis)/1000.0;
    if (dt>0.02){
    // calculate error
      long error = targetPos - encoderPos;

  // proportional
      double pTerm = Kp * error;

      // intergral
      cumulativeError += (error*dt);
      cumulativeError = constrain(cumulativeError,-200.0,200.0);

      double iTerm = Ki * cumulativeError;

      // derivitive
      double dTerm = Kd * ((error - previousError)/dt);

      // calculate pid output

      double output = pTerm + iTerm + dTerm;

      int pwmSpeed = abs((int)output);

      if (pwmSpeed > 0 && pwmSpeed<MIN_PWM){
        pwmSpeed=MIN_PWM;
      }
      if (pwmSpeed > 255){
        pwmSpeed=255;
      }

      if (abs(error)<=1){
        stopMotor();
      } else if(0<output){ 
        spinBackward(pwmSpeed);
      } else if(0>output){
        spinForward(pwmSpeed);
      }

      previousError = error;
      previousMillis = currentMillis;

  }
  if ((currentMillis - previousMillisLCD) >= intervalLCD){
    previousMillisLCD = currentMillis;

    updateLCD();
  }
}


