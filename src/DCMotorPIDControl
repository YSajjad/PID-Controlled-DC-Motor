// Motor driver pins - L298N
const int ENA = 10; // Allows for PWM
const int IN1 = 8;
const int IN2 = 9;

// Encoder pins
const int ENCODER_A = 3;
const int ENCODER_B = 4;

// position counter
volatile long encoderPos = 0;

// encoder interrupt
void readEncoder(){
  if (digitalRead(ENCODER_B)==LOW){
    encoderPos++;
  }else{
    encoderPos--;
  }
}


// motorr control functions

void stopMotor(){
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  analogWrite(ENA,0);
}
void spinForward(int speed){
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  analogWrite(ENA,speed);
}

void spinBackward(int speed){
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  analogWrite(ENA,speed);
}

void setup() {
  Serial.begin(9600);

  pinMode(ENA, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);

  pinMode(ENCODER_A, INPUT_PULLUP);
  pinMode(ENCODER_B, INPUT_PULLUP);

  attachInterrupt(digitalPinToInterrupt(ENCODER_A), readEncoder, RISING);
}

void loop(){
  spinForward(100);
  delay(1000);
  Serial.println("Ticks:"+ String(encoderPos));

  stopMotor();
  
  spinBackward(100);
  delay(1000);
  Serial.println("Ticks:"+ String(encoderPos));

  stopMotor();
}


